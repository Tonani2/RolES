@page "/perfil"
@using RolES.Frontend.Modelos
@inject HttpClient http
<h1>Perfil</h1>

@if (UsuarioAtual != null)
{
    <p>Nome: @UsuarioAtual.Nome </p>
    <p>Email: @UsuarioAtual.Email </p>

}

@code {
    private UsuarioDto? UsuarioAtual;
    
    protected override async Task OnInitializedAsync()
    {
       var resposta = await http.GetFromJsonAsync<UsuarioDto>("http://senac47278.local/eu");

       UsuarioAtual = resposta;
    }

}